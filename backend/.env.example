PROJECT_NAME=IntelliInterview API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080


#Database Credentials
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelliinterview
DATABASE_URL_TEST=postgresql+asyncpg://postgres:password@localhost:5432/intelliinterview_test


#JWT Credentials
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


#Gemini Credentials
AI_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60
MAX_FOLLOW_UP_QUESTIONS=3


#Supabase Storage (resume PDFs — private bucket)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=resumes


#Interview media (per-answer recordings — separate private bucket)
SUPABASE_MEDIA_BUCKET=interview-media
INTERVIEW_MEDIA_MAX_MB=25


#Transcription (voice-first AUDIO/VIDEO answers — uses the Gemini key above)
TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_TIMEOUT=90