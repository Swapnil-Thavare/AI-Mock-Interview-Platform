PROJECT_NAME=IntelliInterview API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080


#Database Credentials
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelliinterview
DATABASE_URL_TEST=postgresql+asyncpg://postgres:password@localhost:5432/intelliinterview_test


#JWT Credentials
JWT_SECRET_KEY=your-secret-key-here


#Gemini Credentials
AI_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest


#Supabase Credentials
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key-here
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_MEDIA_BUCKET=interview-media
INTERVIEW_MEDIA_MAX_MB=14


#Transcription (voice-first AUDIO/VIDEO answers — uses the Gemini key above)
TRANSCRIPTION_PROVIDER=gemini
